<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="osmdroid_prefs.xml" />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="trails" />
        <exclude domain="file" path="routes" />
        <exclude domain="file" path="plans" />
        <exclude domain="file" path="geofa" />
        <exclude domain="file" path="osm_pois" />
        <exclude domain="file" path="offline" />
        <exclude domain="file" path="brouter" />
        <exclude domain="file" path="osmdroid" />
        <exclude domain="file" path="wp_photo_*" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="osmdroid_prefs.xml" />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="trails" />
        <exclude domain="file" path="routes" />
        <exclude domain="file" path="plans" />
        <exclude domain="file" path="geofa" />
        <exclude domain="file" path="osm_pois" />
        <exclude domain="file" path="offline" />
        <exclude domain="file" path="brouter" />
        <exclude domain="file" path="osmdroid" />
        <exclude domain="file" path="wp_photo_*" />
    </device-transfer>
</data-extraction-rules>
