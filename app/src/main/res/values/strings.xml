    <!-- Privatliv & Databrug (Item 9) -->
    <string name="privacy_title">Privatliv &amp; Databrug</string>
    <string name="privacy_subtitle">Ingen konti, ingen reklamer og ingen sporing</string>
    <string name="privacy_no_tracking_headline">Ingen brugerkonti, reklamer eller sporing</string>
    <string name="privacy_no_tracking_body">Dansk Sti kræver ingen oprettelse af konto, indeholder ingen reklamer og anvender ingen analyse- eller sporingsværktøjer. Dine gemte turplaner, ruter, egne punkter og GPS-spor gemmes udelukkende lokalt på din enhed.</string>
    <string name="privacy_services_section_title">Tjenester der modtager koordinater</string>
    <string name="privacy_services_intro">Når du bruger onlinefunktioner i appen, sendes de relevante geografiske koordinater eller kortudsnit kun til følgende tjenester for at hente kort-, rute- og vejrdata:</string>
    <string name="privacy_service_brouter_title">brouter.de</string>
    <string name="privacy_service_brouter_desc">Modtager start-, slut- og rutepunkter ( samt eventuelle no-go polygoner ) ved online ruteplanlægning langs stier.</string>
    <string name="privacy_service_overpass_title">overpass-api.de</string>
    <string name="privacy_service_overpass_desc">Modtager kortudsnit eller rutekorridorer ved opslag af vandreruter, shelters, vandposter, toiletter, indkøb, kollektiv trafik og adgangsforhold i OpenStreetMap.</string>
    <string name="privacy_service_openmeteo_title">api.open-meteo.com</string>
    <string name="privacy_service_openmeteo_desc">Modtager koordinater langs ruten ved hentning af lokale vejrudsigter, solnedgangstider og terrænhøjder (Copernicus DEM).</string>
    <string name="privacy_service_dataforsyningen_title">api.dataforsyningen.dk</string>
    <string name="privacy_service_dataforsyningen_desc">Modtager kortudsnit (bounding box) ved visning og offline-download af Skærmkortet, GeoDanmark Luftfoto og Danmarks Højdemodel (DHM).</string>
    <string name="privacy_service_tiles_title">Kortfliseudbyderen (tile provider)</string>
    <string name="privacy_service_tiles_desc">Den valgte kortfliseudbyder (Dataforsyningen, Thunderforest Outdoors, OpenTopoMap eller OpenStreetMap) modtager kortflise-koordinater (zoom, x, y) for det viste kortområde.</string>

