# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# DATAFORSYNINGEN_API_KEY / SKM_API_KEY:
# API token from Dataforsyningen (Klimadatastyrelsen / SDFI) to load official Danish
# topographic Skærmkort (dtk_skaermkort) map tiles.
# Either DATAFORSYNINGEN_API_KEY or SKM_API_KEY can be used.
DATAFORSYNINGEN_API_KEY="DEFAULT_KEY"
SKM_API_KEY="DEFAULT_KEY"

# THUNDERFOREST_API_KEY / OUTDOOR_MAP_API_KEY:
# API key for Thunderforest Outdoors base map tile provider.
# Provides detailed hiking paths, forest tracks, and contour lines with offline caching.
# If left as DEFAULT_KEY or empty, OpenTopoMap and OpenStreetMap are used as fallbacks.
THUNDERFOREST_API_KEY="DEFAULT_KEY"
OUTDOOR_MAP_API_KEY="DEFAULT_KEY"
