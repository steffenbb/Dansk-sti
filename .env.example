# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# DATAFORSYNINGEN_API_KEY / SKM_API_KEY:
# API token from Dataforsyningen (Klimadatastyrelsen / SDFI) to load official Danish
# topographic Skærmkort (dtk_skaermkort) map tiles.
# Either DATAFORSYNINGEN_API_KEY or SKM_API_KEY can be used.
DATAFORSYNINGEN_API_KEY="DEFAULT_KEY"
SKM_API_KEY="DEFAULT_KEY"
